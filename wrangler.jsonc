{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latihan-kosakata-korea",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
